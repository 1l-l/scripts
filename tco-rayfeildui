	Name = "Spin parts",
	CurrentValue = true,
	Callback = function(Value)
		SpinParts = Value
	end,
})

BuildTab:CreateToggle({
	Name = "Black hole",
	CurrentValue = false,
	Callback = function(Value)
		if Value then
			BlackHole = true
			for _, v in pairs(workspace:GetDescendants()) do
				if v.ClassName == "Part" and not v.Anchored and not v.Parent:FindFirstChild("Humanoid") and not v:FindFirstAncestorOfClass("Tool") then
					ConnectPart(v, character.HumanoidRootPart.RootAttachment, SpinParts)
				end
			end
		else
			BlackHole = false
			FixParts()
		end
	end,
})

