function FixParts()
	for _, v in pairs(workspace:GetDescendants()) do
		if v:FindFirstChild("AlignPosition") then
			v.AlignPosition:Destroy()
			if v:FindFirstChild("Torque") then
				v.Torque:Destroy()
			end
			v.CanCollide = true
		end
	end
end

