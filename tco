InputB1:OnChanged(function(input)
	local player = findPlayer(input)
	if player then
		if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
			for _, v in pairs(workspace:GetDescendants()) do
				if v.ClassName == "Part" and not v.Anchored and not v.Parent:FindFirstChild("Humanoid") and not v:FindFirstAncestorOfClass("Tool") then
					ConnectPart(v, player.Character.HumanoidRootPart.RootAttachment, true)
