local SelectedValues = {}

InputA4:OnChanged(function()
	local player = findPlayer(InputA4.Value)
	if player and not table.find(SelectedValues , player.Name) and player ~= game.Players.LocalPlayer then
		local NewFunction = player.CharacterAdded:Connect(function(Newcharacter)
			Newcharacter.ChildAdded:Connect(function(child)
				if child.Name == "The Arkenstone" then
					game:GetService("TextChatService").TextChannels.TextChannel:SendAsync("reset "..player.Name)
				end
			end)
		end)
		StoredFunctions[player] = NewFunction
		table.insert(SelectedValues, player.Name)
		Notify("Connected function for "..player.Name)
	elseif table.find(SelectedValues, player.Name) then
		StoredFunctions[player]:Disconnect()
		StoredFunctions[player] = nil
		if table.find(SelectedValues, player.Name) then
			table.remove(SelectedValues, table.find(SelectedValues, player.Name))
		end
		Notify("Disconnected function for "..player)
	elseif FinishedExecuting then
		Notify("Invaild name")
	end
	if FinishedExecuting then
		task.wait(0.5)
		Notify("Selected players: "..table.concat(SelectedValues, ", "))
	end
end)

game.Players.PlayerRemoving:Connect(function(player)
	if table.find(SelectedValues, player) then
		table.remove(SelectedValues, table.find(SelectedValues, player))
		StoredFunctions[player]:Disconnect()
	end
end)

