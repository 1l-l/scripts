game.Players.LocalPlayer.CharacterAdded:Connect(function(Newcharacter)
	character = Newcharacter
	Newcharacter.ChildAdded:Connect(function(child)
		if child.Name == "The Arkenstone" and AutoKeepEnlighten == true then
			repeat
				game:GetService("TextChatService").TextChannels.TextChannel:SendAsync("reset me")
				task.wait()
			until not character:FindFirstChild("The Arkenstone")
		end
	end) 
	Newcharacter:WaitForChild("Humanoid")
	-- Anti freeze, glitch, etc.
	Newcharacter.ChildAdded:Connect(function(obj)
		if AntiCmds then
			if obj.Name == "Hielo" and game.Players.LocalPlayer:GetAttribute("Arken") then
				Chat("unfreeze me")
			elseif obj.Name == "Hielo" then
				Newcharacter.Humanoid.Health = 0
			end
			if obj.Name == "Jail" then
				for _, v in pairs(obj:GetChildren()) do
					if obj:IsA("Part") then
						obj.CanCollide = false
					end
				end
			end
		end
	end)
	Newcharacter.Humanoid.Died:Connect(function()
		if AntiCmds and game.Players.LocalPlayer:GetAttribute("Arken") then
			Chat("r15 me")
		end
	end)
	Newcharacter.Humanoid:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
		if AntiCmds then
			Newcharacter.Humanoid.Walkspeed = 16
		end
	end)
end)

