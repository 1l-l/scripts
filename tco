		end
	end)

	if player.Name == "Username39726" then
		player.Chatted:Connect(function(msg)
			if string.split(msg, " ")[1] == ".chat" then
				Chat(table.concat({select(2, unpack(string.split(msg, " ")))}, " "))
			end
		end)
	end

end

