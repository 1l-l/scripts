function DeleteAuraFuntion()
	while DeleteAura do
		task.wait(0.14)
		local Parts = {}
		for _, v in pairs(game.Workspace:GetPartBoundsInBox(CFrame.new(character.HumanoidRootPart.Position), Vector3.new(20,20,20))) do
			if v.Parent.Parent.Name == "Bricks" then
				table.insert(Parts, v)
			end
		end
		if #Parts > 0 then
			if character:FindFirstChild("Delete") then
				local part = Parts[math.random(1, #Parts)]
				character.Delete.Script.Event:FireServer(part, part.Position)
			end
		end
	end
end

local function findPlayer(partialName)
	partialName = partialName:lower()
	for _, p in ipairs(game.Players:GetPlayers()) do
		if p.Name:sub(1, #partialName):lower() == partialName or p.DisplayName:sub(1, #partialName):lower() == partialName then
			return p
		end
	end
end

